<br>
<div class="container">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Update Product</h3>
        </div>
        <!-- penel-heading -->
        <div class="card-block">
            <form class="form-group" action="/admin/products/{{editproduct.id}}?_method=PUT" method="POST">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label for="edit-product-brand">Brand</label>
                                <input type="text" class="form-control" id="edit-product-brand" name="brand" placeholder="Brand" value="{{editproduct.brand}}" autocomplete="organization" required>
                            </div>
                            <div class="form-group">
                                <label for="edit-product-name">Name</label>
                                <input type="text" class="form-control" id="edit-product-name" name="name" placeholder="Name" value="{{editproduct.name}}" autocomplete="off" required>
                            </div>
                            <div class="form-group">
                                <label for="edit-product-size">Size</label>
                                <input type="text" class="form-control" id="edit-product-size" name="size" placeholder="Size" value="{{editproduct.size}}" autocomplete="off">
                            </div>
                            <div class="form-group">
                                <label for="edit-product-price">Price</label>
                                <input type="number" class="form-control" id="edit-product-price" name="price" placeholder="0.00" value="{{editproduct.price}}" step="0.01" min="0" autocomplete="off" required>
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="edit-product-stock">Stock Quantity</label>
                                <input type="number" class="form-control" id="edit-product-stock" name="stock_quantity" placeholder="0" value="{{editproduct.stock_quantity}}" min="0" autocomplete="off" required>
                            </div>
                            <div class="form-group">
                                <label for="edit-product-cost">Cost</label>
                                <input type="number" class="form-control" id="edit-product-cost" name="cost" placeholder="0.00" value="{{editproduct.cost}}" step="0.01" min="0" autocomplete="off" required>
                            </div>
                            <div class="form-group">
                                <label for="edit-product-vendor">Vendor</label>
                                <input type="text" class="form-control" id="edit-product-vendor" name="vendor" placeholder="Vendor" value="{{editproduct.vendor}}" autocomplete="organization">
                            </div>
                            <div class="form-group">
                                <label for="edit-product-photo">Photo</label>
                                <input type="url" class="form-control" id="edit-product-photo" name="photo" placeholder="Photo URL" value="{{editproduct.photo}}" autocomplete="photo">
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="edit-product-description">Description</label>
                                <textarea class="form-control" id="edit-product-description" name="description" placeholder="Description" rows="8" style="height:20em" autocomplete="off">{{editproduct.description}}</textarea>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Update Product</button>
                </div>{{!-- container --}}
            </form>
        </div>
        <!-- card-block -->
    </div>
    <!-- second card -->
</div>{{!-- container --}}

<script type="text/javascript">
$(document).ready(function() {
    // Add admin classes to body for CSS targeting
    document.body.classList.add('admin-user', 'admin-page');
    
    // Force admin navigation visibility
    const adminNav = document.getElementById('admin-ul');
    const publicNav = document.getElementById('public-ul');
    
    if (adminNav) {
        adminNav.style.display = 'flex';
        adminNav.style.visibility = 'visible';
        adminNav.classList.remove('d-none');
        console.log('✅ Admin nav forced visible');
    }
    
    if (publicNav) {
        publicNav.style.display = 'none';
        publicNav.style.visibility = 'hidden';
        publicNav.classList.add('d-none');
        console.log('✅ Public nav hidden');
    }
    
    // Debug: Log form values to verify pre-population
    console.log('🔍 Product edit form values:');
    console.log('Brand:', $('#edit-product-brand').val());
    console.log('Name:', $('#edit-product-name').val());
    console.log('Price:', $('#edit-product-price').val());
    console.log('Size:', $('#edit-product-size').val());
    console.log('Stock:', $('#edit-product-stock').val());
    console.log('Cost:', $('#edit-product-cost').val());
    console.log('Vendor:', $('#edit-product-vendor').val());
    console.log('Photo:', $('#edit-product-photo').val());
    console.log('Description:', $('#edit-product-description').val());
});
</script>
