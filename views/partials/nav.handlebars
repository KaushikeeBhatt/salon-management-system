<script>
// Global authentication state
let currentUser = null;
let isAuthenticated = false;

// Add active class to current page
$(document).ready(function() {
    const currentPage = window.location.pathname;
    $('.nav-link').each(function() {
        if ($(this).attr('href') === currentPage) {
            $(this).addClass('active');
            $(this).attr('aria-current', 'page');
        }
    });
    
    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
    
    // Check user authentication status on page load
    // Delay slightly if on dashboard to let dashboard handle its own auth check first
    if (window.location.pathname === '/dashboard') {
        setTimeout(checkAuthStatus, 1000);
    } else {
        // Normal check for regular page loads
        performAuthCheck();
    }
    
    // Header login button
    $('#headerLoginBtn').on('click', function() {
        console.log('🔄 Redirecting to Google OAuth...');
        window.location.href = '/auth/google';
    });
    
    // Header logout button
    $('#headerLogoutBtn').on('click', function(e) {
        e.preventDefault();
        
        console.log('🔄 Logging out...');
        
        fetch('/auth/logout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update global state
                currentUser = null;
                isAuthenticated = false;
                
                // Update UI
                updateNavAuthState(false);
                
                Swal.fire({
                    icon: 'success',
                    title: 'Signed Out',
                    text: 'You have been successfully signed out.',
                    confirmButtonColor: '#6366f1'
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Logout Failed',
                    text: 'Failed to sign out. Please try again.',
                    confirmButtonColor: '#6366f1'
                });
            }
        })
        .catch(error => {
            console.error('❌ Error during logout:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Network error during logout. Please try again.',
                confirmButtonColor: '#6366f1'
            });
        });
    });
    
    // Handle appointment form submission
    $('#appointmentForm').on('submit', function(e) {
        e.preventDefault();
        
        // Check authentication first
        if (!isAuthenticated) {
            Swal.fire({
                icon: 'warning',
                title: 'Sign In Required',
                text: 'Please sign in to book an appointment.',
                confirmButtonColor: '#6366f1',
                confirmButtonText: 'Sign In'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/auth/google';
                }
            });
            return;
        }
        
        // Check if form is valid
        if (!this.checkValidity()) {
            e.stopPropagation();
            $(this).addClass('was-validated');
            return;
        }
        
        const formData = {
            service: $('#service').val(),
            phone: $('#phone').val(),
            preferredDate: $('#preferredDate').val(),
            preferredTime: $('#preferredTime').val(),
            notes: $('#notes').val()
        };
        
        // Show loading state
        const submitBtn = $(this).find('button[type="submit"]');
        const originalText = submitBtn.html();
        submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Submitting...');
        
        // Submit appointment request
        fetch('/appointment-request', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Close modal
                $('#appointmentModal').modal('hide');
                
                // Show success message
                Swal.fire({
                    icon: 'success',
                    title: 'Appointment Requested!',
                    html: `
                        <p>Your appointment request has been submitted successfully.</p>
                        <p><strong>Confirmation Code:</strong> <code>${data.confirmationCode}</code></p>
                        <p>We will contact you soon to confirm your appointment.</p>
                    `,
                    confirmButtonColor: '#6366f1',
                    confirmButtonText: 'View My Dashboard'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/dashboard';
                    }
                });
                
                // Reset form
                $('#appointmentForm')[0].reset();
                $('#appointmentForm').removeClass('was-validated');
            } else {
                if (data.requiresLogin) {
                    // User needs to login
                    Swal.fire({
                        icon: 'warning',
                        title: 'Sign In Required',
                        text: data.message,
                        confirmButtonColor: '#6366f1',
                        confirmButtonText: 'Sign In'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/auth/google';
                        }
                    });
                } else {
                    // Other error
                    Swal.fire({
                        icon: 'error',
                        title: 'Booking Failed',
                        text: data.message,
                        confirmButtonColor: '#6366f1'
                    });
                }
            }
        })
        .catch(error => {
            console.error('❌ Error submitting appointment:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Failed to submit appointment request. Please try again.',
                confirmButtonColor: '#6366f1'
            });
        })
        .finally(() => {
            // Restore button state
            submitBtn.prop('disabled', false).html(originalText);
        });
    });
});

// Toggle between login required and booking form sections based on authentication status
function toggleBookingModalSections(authenticated, user = null) {
    if (authenticated && user) {
        $('#loginRequiredSection').hide();
        $('#bookingFormSection').show();
        
        // Show welcome message with user name
        $('#welcomeMessage').show();
        $('#welcomeUserName').text(user.name || 'User');
    } else {
        $('#loginRequiredSection').show();
        $('#bookingFormSection').hide();
    }
}

// Check authentication status when booking modal is shown
$('#appointmentModal').on('shown.bs.modal', function() {
    console.log('📋 Booking modal opened, checking auth status...');
    checkModalAuthStatus();
});

// Update booking modal sections based on authentication status
function checkModalAuthStatus() {
    fetch('/auth/user')
        .then(response => response.json())
        .then(data => {
            console.log('📋 Modal auth check result:', data);
            toggleBookingModalSections(data.isAuthenticated, data.user);
        })
        .catch(error => {
            console.error('❌ Error checking modal auth status:', error);
            toggleBookingModalSections(false);
        });
}

// Check authentication status for navigation
function checkAuthStatus() {
    console.log('🔄 Checking authentication status...');
    
    // Check for URL parameters to determine if we just completed OAuth
    const urlParams = new URLSearchParams(window.location.search);
    const authStatus = urlParams.get('auth');
    
    // If we just came from OAuth, use retry logic
    if (authStatus === 'success') {
        console.log('🔄 Just completed OAuth, checking session with retry logic...');
        checkAuthWithRetry();
    } else {
        // Normal check for regular page loads
        performAuthCheck();
    }
}

function checkAuthWithRetry(attempt = 1, maxAttempts = 5) {
    console.log(`🔄 Nav auth check attempt ${attempt}/${maxAttempts}...`);
    
    fetch('/auth/user', {
        method: 'GET',
        credentials: 'same-origin',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        return response.json();
    })
    .then(data => {
        console.log('✅ Nav auth check response:', data);
        
        if (data.success && data.isAuthenticated && data.user) {
            console.log('✅ Session found on attempt', attempt);
            // Update global state
            isAuthenticated = data.isAuthenticated;
            currentUser = data.user;
            
            // Update UI
            updateNavAuthState(isAuthenticated, currentUser);
        } else {
            // Session not ready yet, retry if we haven't exceeded max attempts
            if (attempt < maxAttempts) {
                const delay = Math.min(1000 * Math.pow(2, attempt - 1), 5000); // Exponential backoff, max 5s
                console.log(`⏳ Session not ready, retrying in ${delay}ms (attempt ${attempt + 1}/${maxAttempts})`);
                console.log('🔍 Debug info:', data.debug);
                
                setTimeout(() => {
                    checkAuthWithRetry(attempt + 1, maxAttempts);
                }, delay);
            } else {
                console.log('❌ Max retry attempts reached, showing not authenticated state');
                console.log('🔍 Final debug info:', data.debug);
                // Set default state
                isAuthenticated = false;
                currentUser = null;
                updateNavAuthState(false);
            }
        }
    })
    .catch(error => {
        console.error(`❌ Error on nav auth check attempt ${attempt}:`, error);
        
        // Retry on error if we haven't exceeded max attempts
        if (attempt < maxAttempts) {
            const delay = Math.min(1000 * Math.pow(2, attempt - 1), 5000); // Exponential backoff, max 5s
            console.log(`⏳ Retrying due to error in ${delay}ms (attempt ${attempt + 1}/${maxAttempts})`);
            
            setTimeout(() => {
                checkAuthWithRetry(attempt + 1, maxAttempts);
            }, delay);
        } else {
            console.log('❌ Max retry attempts reached due to errors, showing not authenticated state');
            // Set default state
            isAuthenticated = false;
            currentUser = null;
            updateNavAuthState(false);
        }
    });
}

function performAuthCheck() {
    fetch('/auth/user', {
        method: 'GET',
        credentials: 'same-origin',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        return response.json();
    })
    .then(data => {
        console.log('✅ Nav auth status response:', data);
        
        // Update global state
        isAuthenticated = data.isAuthenticated || false;
        currentUser = data.user || null;
        
        // Update UI
        updateNavAuthState(isAuthenticated, currentUser);
    })
    .catch(error => {
        console.error('❌ Error checking nav auth status:', error);
        
        // Set default state
        isAuthenticated = false;
        currentUser = null;
        updateNavAuthState(false);
    });
}

function updateNavAuthState(authenticated, user = null) {
    console.log('🔄 Updating nav auth state:', { authenticated, user: user?.name, role: user?.role });
    
    if (authenticated && user) {
        // Show logged in state
        $('#notLoggedIn').addClass('d-none');
        $('#loggedIn').removeClass('d-none');
        
        // Update user info
        $('#userNameNav').text(user.name || 'User');
        
        // Update avatar
        if (user.picture) {
            $('#userAvatarImg').attr('src', user.picture).show();
            $('#userAvatarIcon').hide();
        } else {
            $('#userAvatarImg').hide();
            $('#userAvatarIcon').show();
        }

        // Use global function to handle role-based UI changes
        if (typeof updateUIVisibility === 'function') {
            updateUIVisibility(user);
        }
        
        console.log('✅ User interface updated for:', user.name);
    } else {
        // Show not logged in state
        $('#notLoggedIn').removeClass('d-none');
        $('#loggedIn').addClass('d-none');
        
        // Use global function for guest users
        if (typeof updateUIVisibility === 'function') {
            updateUIVisibility(null);
        }
        
        console.log('✅ User interface updated for guest user');
    }
}

// Sign in for booking
function signInForBooking() {
    console.log('🔄 Signing in for booking...');
    window.location.href = '/auth/google';
}

// Global function to refresh auth status (can be called from other pages)
window.refreshAuthStatus = function() {
    checkAuthStatus();
};
</script>