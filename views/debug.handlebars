<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">🔧 Debug & Test Page</h1>
            <p class="text-muted">Use this page to test authentication and appointment lookup functionality</p>
        </div>
    </div>
    
    <!-- Authentication Test Section -->
    <div class="row mb-5">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3>🔐 Authentication Test</h3>
                </div>
                <div class="card-body">
                    <div id="authStatus" class="mb-3">
                        <span class="badge bg-secondary">Checking...</span>
                    </div>
                    
                    <div id="authButtons">
                        <button class="btn btn-primary" onclick="testGoogleAuth()">
                            <i class="fab fa-google me-2"></i>Test Google Login
                        </button>
                        <button class="btn btn-info ms-2" onclick="checkAuthStatus()">
                            <i class="fas fa-refresh me-2"></i>Check Status
                        </button>
                        <button class="btn btn-danger ms-2" onclick="testLogout()">
                            <i class="fas fa-sign-out-alt me-2"></i>Test Logout
                        </button>
                    </div>
                    
                    <div id="userInfo" class="mt-3" style="display: none;">
                        <h5>User Information:</h5>
                        <pre id="userDetails" class="bg-light p-3 rounded"></pre>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Appointment Lookup Test -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3>📋 Appointment Lookup Test</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Test Confirmation Code:</label>
                        <input type="text" id="testCode" class="form-control" placeholder="Enter confirmation code">
                    </div>
                    
                    <div class="mb-3">
                        <button class="btn btn-success" onclick="testAppointmentLookup()">
                            <i class="fas fa-search me-2"></i>Test Lookup
                        </button>
                        <button class="btn btn-info ms-2" onclick="showAllAppointments()">
                            <i class="fas fa-list me-2"></i>Show All Codes
                        </button>
                    </div>
                    
                    <div id="appointmentResult" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- System Information -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>ℹ️ System Information</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Current URL:</h5>
                            <code id="currentUrl"></code>
                            
                            <h5 class="mt-3">Session Info:</h5>
                            <div id="sessionInfo"></div>
                        </div>
                        <div class="col-md-6">
                            <h5>Browser Info:</h5>
                            <div id="browserInfo"></div>
                            
                            <h5 class="mt-3">Console Logs:</h5>
                            <div id="consoleLogs" class="bg-dark text-light p-3 rounded" style="height: 200px; overflow-y: auto; font-family: monospace; font-size: 12px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Initialize page
    updateSystemInfo();
    checkAuthStatus();
    
    // Capture console logs
    const originalLog = console.log;
    const originalError = console.error;
    
    console.log = function(...args) {
        originalLog.apply(console, args);
        addToConsoleLog('LOG', args.join(' '));
    };
    
    console.error = function(...args) {
        originalError.apply(console, args);
        addToConsoleLog('ERROR', args.join(' '));
    };
});

function updateSystemInfo() {
    document.getElementById('currentUrl').textContent = window.location.href;
    
    const browserInfo = `
        User Agent: ${navigator.userAgent}
        Language: ${navigator.language}
        Platform: ${navigator.platform}
        Cookies Enabled: ${navigator.cookieEnabled}
    `;
    document.getElementById('browserInfo').innerHTML = `<pre>${browserInfo}</pre>`;
}

function addToConsoleLog(type, message) {
    const logs = document.getElementById('consoleLogs');
    const timestamp = new Date().toLocaleTimeString();
    const logEntry = `[${timestamp}] ${type}: ${message}\n`;
    logs.textContent += logEntry;
    logs.scrollTop = logs.scrollHeight;
}

function checkAuthStatus() {
    console.log('Checking authentication status...');
    
    fetch('/auth/user')
        .then(response => response.json())
        .then(data => {
            console.log('Auth status response:', data);
            
            if (data.isAuthenticated && data.user) {
                document.getElementById('authStatus').innerHTML = 
                    '<span class="badge bg-success">✅ Authenticated</span>';
                document.getElementById('userInfo').style.display = 'block';
                document.getElementById('userDetails').textContent = JSON.stringify(data.user, null, 2);
            } else {
                document.getElementById('authStatus').innerHTML = 
                    '<span class="badge bg-warning">❌ Not Authenticated</span>';
                document.getElementById('userInfo').style.display = 'none';
            }
            
            document.getElementById('sessionInfo').innerHTML = `<pre>${JSON.stringify(data, null, 2)}</pre>`;
        })
        .catch(error => {
            console.error('Error checking auth status:', error);
            document.getElementById('authStatus').innerHTML = 
                '<span class="badge bg-danger">❌ Error</span>';
        });
}

function testGoogleAuth() {
    console.log('Testing Google authentication...');
    window.location.href = '/auth/google';
}

function testLogout() {
    console.log('Testing logout...');
    
    fetch('/auth/logout', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        console.log('Logout response:', data);
        if (data.success) {
            alert('Logout successful!');
            checkAuthStatus();
        } else {
            alert('Logout failed: ' + data.error);
        }
    })
    .catch(error => {
        console.error('Logout error:', error);
        alert('Logout error: ' + error.message);
    });
}

function testAppointmentLookup() {
    const code = document.getElementById('testCode').value.trim();
    if (!code) {
        alert('Please enter a confirmation code');
        return;
    }
    
    console.log(`Testing appointment lookup for code: ${code}`);
    
    fetch(`/appointment-status/${code}`)
        .then(response => response.json())
        .then(data => {
            console.log('Appointment lookup response:', data);
            
            const resultDiv = document.getElementById('appointmentResult');
            if (data.success) {
                resultDiv.innerHTML = `
                    <div class="alert alert-success">
                        <h5>✅ Appointment Found!</h5>
                        <pre>${JSON.stringify(data.appointment, null, 2)}</pre>
                    </div>
                `;
            } else {
                resultDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <h5>❌ Appointment Not Found</h5>
                        <p>${data.message}</p>
                        ${data.debug ? `<pre>Debug Info: ${JSON.stringify(data.debug, null, 2)}</pre>` : ''}
                    </div>
                `;
            }
        })
        .catch(error => {
            console.error('Appointment lookup error:', error);
            document.getElementById('appointmentResult').innerHTML = `
                <div class="alert alert-danger">
                    <h5>❌ Error</h5>
                    <p>${error.message}</p>
                </div>
            `;
        });
}

function showAllAppointments() {
    console.log('Fetching all appointments for debugging...');
    
    fetch('/debug/appointments')
        .then(response => response.json())
        .then(data => {
            console.log('All appointments response:', data);
            
            const resultDiv = document.getElementById('appointmentResult');
            if (data.success) {
                resultDiv.innerHTML = `
                    <div class="alert alert-info">
                        <h5>📋 Available Confirmation Codes (${data.count} total)</h5>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${data.appointments.map(apt => `
                                        <tr>
                                            <td><code>${apt.confirmationCode}</code></td>
                                            <td>${apt.firstName} ${apt.lastName}</td>
                                            <td><span class="badge bg-primary">${apt.status}</span></td>
                                            <td>${new Date(apt.createdAt).toLocaleDateString()}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                `;
            } else {
                resultDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <h5>❌ Error fetching appointments</h5>
                        <p>${data.error}</p>
                    </div>
                `;
            }
        })
        .catch(error => {
            console.error('Error fetching appointments:', error);
            document.getElementById('appointmentResult').innerHTML = `
                <div class="alert alert-danger">
                    <h5>❌ Error</h5>
                    <p>${error.message}</p>
                </div>
            `;
        });
}
</script>
