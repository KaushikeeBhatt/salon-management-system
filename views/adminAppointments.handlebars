<script>
$(document).ready(function() {
    // Add admin classes to body for CSS targeting
    document.body.classList.add('admin-user', 'admin-page');
    
    // Force admin navigation visibility
    const adminNav = document.getElementById('admin-ul');
    const publicNav = document.getElementById('public-ul');
    
    if (adminNav) {
        adminNav.style.display = 'flex';
        adminNav.style.visibility = 'visible';
        adminNav.classList.remove('d-none');
        console.log('✅ Admin nav forced visible');
    }
    
    if (publicNav) {
        publicNav.style.display = 'none';
        publicNav.style.visibility = 'hidden';
        publicNav.classList.add('d-none');
        console.log('✅ Public nav hidden');
    }
    
    // Initialize statistics
    updateStatistics();
    
    // Setup search and filter functionality
    setupSearchAndFilter();
});

let currentAppointmentId = null;

// Helper function to show alerts with fallback
function showAlert(title, text, icon) {
    if (typeof Swal !== 'undefined') {
        Swal.fire({
            title: title,
            text: text,
            icon: icon,
            confirmButtonColor: '#6366f1'
        });
    } else {
        alert(title + ': ' + text);
    }
}

// Update statistics counters
function updateStatistics() {
    const appointments = {{#if appointments}}[{{#each appointments}}{ id: {{this.id}}, status: "{{this.status}}", service: "{{this.service}}" },{{/each}}]{{else}}[]{{/if}};
    
    let pending = 0, confirmed = 0, completed = 0;
    
    appointments.forEach(appointment => {
        switch(appointment.status) {
            case 'pending': pending++; break;
            case 'confirmed': confirmed++; break;
            case 'completed': completed++; break;
        }
    });
    
    $('#pendingCount').text(pending);
    $('#confirmedCount').text(confirmed);
    $('#completedCount').text(completed);
}

// Setup search and filter functionality
function setupSearchAndFilter() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const dateFilter = document.getElementById('dateFilter');
    
    function filterAppointments() {
        const searchTerm = searchInput.value.toLowerCase();
        const statusValue = statusFilter.value;
        const dateValue = dateFilter.value;
        
        const rows = document.querySelectorAll('.appointment-row');
        let visibleCount = 0;
        
        rows.forEach(row => {
            const customer = row.dataset.customer.toLowerCase();
            const service = row.dataset.service.toLowerCase();
            const email = row.dataset.email.toLowerCase();
            const status = row.dataset.status;
            const date = row.dataset.date;
            
            const matchesSearch = !searchTerm || 
                customer.includes(searchTerm) || 
                service.includes(searchTerm) || 
                email.includes(searchTerm);
            
            const matchesStatus = !statusValue || status === statusValue;
            const matchesDate = !dateValue || date === dateValue;
            
            if (matchesSearch && matchesStatus && matchesDate) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });
        
        $('#appointmentCount').text(visibleCount);
    }
    
    if (searchInput) searchInput.addEventListener('input', filterAppointments);
    if (statusFilter) statusFilter.addEventListener('change', filterAppointments);
    if (dateFilter) dateFilter.addEventListener('change', filterAppointments);
}

// Clear all filters
function clearFilters() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const dateFilter = document.getElementById('dateFilter');
    
    if (searchInput) searchInput.value = '';
    if (statusFilter) statusFilter.value = '';
    if (dateFilter) dateFilter.value = '';
    
    // Trigger filter to show all appointments
    if (searchInput) {
        const event = new Event('input');
        searchInput.dispatchEvent(event);
    }
}

// Show loading overlay
function showLoading() {
    document.getElementById('loadingOverlay').classList.remove('d-none');
}

// Hide loading overlay
function hideLoading() {
    document.getElementById('loadingOverlay').classList.add('d-none');
}

// Refresh appointments
function refreshAppointments() {
    showLoading();
    window.location.reload();
}

// Export appointments to CSV
function exportAppointments() {
    try {
        console.log('📤 Exporting appointments...');
        showLoading();
        
        // Get all visible appointment rows
        const rows = document.querySelectorAll('.appointment-row:not([style*="display: none"])');
        
        if (rows.length === 0) {
            hideLoading();
            Swal.fire('No Data', 'No appointments to export', 'info');
            return;
        }
        
        // Prepare CSV data
        const headers = ['Customer Name', 'Email', 'Phone', 'Service', 'Preferred Date', 'Preferred Time', 'Status', 'Booked On'];
        const csvData = [headers];
        
        rows.forEach(row => {
            const customer = row.dataset.customer || 'N/A';
            const email = row.dataset.email || 'N/A';
            const service = row.dataset.service || 'N/A';
            const status = row.dataset.status || 'N/A';
            const date = row.dataset.date || 'N/A';
            
            // Extract additional data from row cells
            const cells = row.querySelectorAll('td');
            const phone = cells[0]?.querySelector('.text-muted.small')?.textContent?.trim() || 'N/A';
            const preferredTime = cells[3]?.querySelector('span')?.textContent?.trim() || 'N/A';
            const bookedOn = cells[5]?.textContent?.trim() || 'N/A';
            
            csvData.push([customer, email, phone, service, date, preferredTime, status, bookedOn]);
        });
        
        // Convert to CSV string
        const csvString = csvData.map(row => 
            row.map(field => `"${String(field).replace(/"/g, '""')}"`).join(',')
        ).join('\n');
        
        // Create and download file
        const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        
        if (link.download !== undefined) {
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', `appointments_${new Date().toISOString().split('T')[0]}.csv`);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            hideLoading();
            Swal.fire('Success', `Exported ${rows.length} appointments to CSV`, 'success');
        } else {
            hideLoading();
            Swal.fire('Error', 'Your browser does not support file downloads', 'error');
        }
    } catch (error) {
        hideLoading();
        console.error('❌ Export error:', error);
        Swal.fire('Error', 'Failed to export appointments: ' + error.message, 'error');
    }
}

function viewAppointment(id) {
    console.log('👁️ Viewing appointment:', id);
    
    if (!id) {
        console.error('❌ No appointment ID provided');
        Swal.fire('Error', 'Invalid appointment ID', 'error');
        return;
    }
    
    showLoading();
    
    fetch(`/admin/appointments/${id}`)
        .then(response => {
            console.log('📡 Response status:', response.status);
            return response.json();
        })
        .then(data => {
            hideLoading();
            console.log('📄 Response data:', data);
            if (data.success) {
                displayAppointmentDetails(data.appointment);
            } else {
                Swal.fire('Error', data.message || 'Failed to load appointment details', 'error');
            }
        })
        .catch(error => {
            hideLoading();
            console.error('❌ Error loading appointment:', error);
            Swal.fire('Error', 'Network error: ' + error.message, 'error');
        });
}

function confirmAppointment(id) {
    console.log('✅ Confirming appointment:', id);
    
    if (!id) {
        console.error('❌ No appointment ID provided for confirmation');
        Swal.fire('Error', 'Invalid appointment ID', 'error');
        return;
    }
    
    currentAppointmentId = id;
    
    // Set minimum date to today
    const now = new Date();
    const localDateTime = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    const dateTimeInput = document.getElementById('confirmedDateTime');
    
    if (!dateTimeInput) {
        console.error('❌ DateTime input not found');
        Swal.fire('Error', 'Form component missing', 'error');
        return;
    }
    
    dateTimeInput.min = localDateTime;
    
    try {
        const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
        modal.show();
        console.log('🎆 Confirmation modal shown');
    } catch (error) {
        console.error('❌ Error showing modal:', error);
        Swal.fire('Error', 'Failed to open confirmation dialog', 'error');
    }
}

function completeAppointment(id) {
    console.log('✅ Marking appointment as completed:', id);
    
    if (!id) {
        console.error('❌ No appointment ID provided for completion');
        showAlert('Error', 'Invalid appointment ID', 'error');
        return;
    }
    
    if (typeof Swal !== 'undefined') {
        Swal.fire({
            title: 'Mark as Completed?',
            text: 'This will mark the appointment as completed. The service has been provided to the customer.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#17a2b8',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Mark Complete'
        }).then((result) => {
            if (result.isConfirmed) {
                updateAppointmentStatus(id, 'completed');
            }
        });
    } else {
        // Fallback to native confirm if SweetAlert is not available
        if (confirm('Mark this appointment as completed?')) {
            updateAppointmentStatus(id, 'completed');
        }
    }
}

function cancelAppointment(id) {
    console.log('❌ Cancelling appointment:', id);
    
    if (!id) {
        console.error('❌ No appointment ID provided for cancellation');
        showAlert('Error', 'Invalid appointment ID', 'error');
        return;
    }
    
    if (typeof Swal !== 'undefined') {
        Swal.fire({
            title: 'Cancel Appointment?',
            text: 'Are you sure you want to cancel this appointment?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Cancel It'
        }).then((result) => {
            if (result.isConfirmed) {
                updateAppointmentStatus(id, 'cancelled');
            }
        });
    } else {
        // Fallback to native confirm if SweetAlert is not available
        if (confirm('Are you sure you want to cancel this appointment?')) {
            updateAppointmentStatus(id, 'cancelled');
        }
    }
}

function deleteAppointment(id) {
    Swal.fire({
        title: 'Delete Appointment?',
        text: 'Are you sure you want to delete this appointment? This action cannot be undone.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Delete It'
    }).then((result) => {
        if (result.isConfirmed) {
            showLoading();
            
            fetch(`/admin/appointments/${id}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                hideLoading();
                if (data.success) {
                    Swal.fire('Success', 'Appointment deleted successfully', 'success')
                        .then(() => location.reload());
                } else {
                    Swal.fire('Error', 'Failed to delete appointment', 'error');
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Error deleting appointment:', error);
                Swal.fire('Error', 'Failed to delete appointment', 'error');
            });
        }
    });
}

function submitConfirmation() {
    const dateTime = document.getElementById('confirmedDateTime').value;
    if (!dateTime) {
        Swal.fire('Error', 'Please select a date and time', 'error');
        return;
    }
    
    showLoading();
    updateAppointmentStatus(currentAppointmentId, 'confirmed', dateTime);
    bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide();
}

function updateAppointmentStatus(id, status, actualDateTime = null) {
    console.log('🔄 Updating appointment status:', { id, status, actualDateTime });
    
    if (!id || !status) {
        console.error('❌ Missing required parameters:', { id, status });
        showAlert('Error', 'Missing appointment ID or status', 'error');
        return;
    }
    
    const data = { status };
    if (actualDateTime) {
        data.actualDateTime = actualDateTime;
    }
    
    showLoading();
    console.log('📤 Sending request to:', `/admin/appointments/${id}/status`);
    console.log('📦 Request data:', data);
    
    fetch(`/admin/appointments/${id}/status`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    })
    .then(response => {
        console.log('📡 Response status:', response.status, response.statusText);
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        return response.json();
    })
    .then(data => {
        hideLoading();
        console.log('📄 Response data:', data);
        if (data.success) {
            const message = data.message || 'Appointment status updated successfully';
            if (typeof Swal !== 'undefined') {
                Swal.fire('Success', message, 'success').then(() => location.reload());
            } else {
                alert('Success: ' + message);
                location.reload();
            }
        } else {
            showAlert('Error', data.message || 'Failed to update appointment', 'error');
        }
    })
    .catch(error => {
        hideLoading();
        console.error('❌ Error updating appointment:', error);
        showAlert('Error', 'Network error: ' + error.message, 'error');
    });
}

