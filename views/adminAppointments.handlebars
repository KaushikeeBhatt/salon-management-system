// Helper function to get status badge HTML
function getStatusBadge(status) {
    const badges = {
        'pending': '<span class="status-badge status-pending"><i class="fas fa-clock me-1"></i>Pending</span>',
        'confirmed': '<span class="status-badge status-confirmed"><i class="fas fa-check-circle me-1"></i>Confirmed</span>',
        'completed': '<span class="status-badge status-completed"><i class="fas fa-calendar-check me-1"></i>Completed</span>',
        'cancelled': '<span class="status-badge status-cancelled"><i class="fas fa-times-circle me-1"></i>Cancelled</span>'
    };
    return badges[status] || status;
}
