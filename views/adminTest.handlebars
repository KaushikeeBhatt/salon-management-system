<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">🔧 Admin System Test</h1>
            <p class="lead">This page helps diagnose admin system issues.</p>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-user-shield me-2"></i>Authentication Status</h5>
                </div>
                <div class="card-body">
                    <div id="authStatus">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Checking authentication...</p>
                        </div>
                    </div>
                    <button class="btn btn-outline-primary btn-sm mt-3" onclick="refreshAuth()">
                        <i class="fas fa-refresh me-2"></i>Refresh Status
                    </button>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-database me-2"></i>Database Test</h5>
                </div>
                <div class="card-body">
                    <div id="dbStatus">
                        <p class="text-muted">Click test button to check database connection</p>
                    </div>
                    <button class="btn btn-outline-success btn-sm" onclick="testDatabase()">
                        <i class="fas fa-database me-2"></i>Test Database
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-cogs me-2"></i>Admin Functions Test</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <button class="btn btn-info btn-sm w-100" onclick="testRoute('/admin/api/stats/appointments')">
                                <i class="fas fa-calendar me-2"></i>Test Appointments
                            </button>
                        </div>
                        <div class="col-md-3 mb-2">
                            <button class="btn btn-success btn-sm w-100" onclick="testRoute('/admin/api/stats/customers')">
                                <i class="fas fa-users me-2"></i>Test Customers
                            </button>
                        </div>
                        <div class="col-md-3 mb-2">
                            <button class="btn btn-warning btn-sm w-100" onclick="testRoute('/admin/api/stats/products')">
                                <i class="fas fa-shopping-bag me-2"></i>Test Products
                            </button>
                        </div>
                        <div class="col-md-3 mb-2">
                            <button class="btn btn-primary btn-sm w-100" onclick="testRoute('/admin/api/stats/staff')">
                                <i class="fas fa-user-tie me-2"></i>Test Staff
                            </button>
                        </div>
                    </div>
                    <div id="testResults" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-shield-alt me-2"></i>Role Configuration</h5>
                </div>
                <div class="card-body">
                    <div id="roleInfo">
                        <p class="text-muted">Click button to check role configuration</p>
                    </div>
                    <button class="btn btn-outline-warning btn-sm" onclick="checkRoleConfig()">
                        <i class="fas fa-user-cog me-2"></i>Check Role Config
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Check auth status on page load
    refreshAuth();
});

function refreshAuth() {
    $('#authStatus').html(`
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Checking authentication...</p>
        </div>
    `);
    
    fetch('/auth/user')
        .then(response => response.json())
        .then(data => {
            console.log('Auth check response:', data);
            
            if (data.success && data.isAuthenticated) {
                $('#authStatus').html(`
                    <div class="alert alert-success">
                        <h6><i class="fas fa-check-circle me-2"></i>Authenticated</h6>
                        <ul class="mb-0">
                            <li><strong>Name:</strong> ${data.user.name}</li>
                            <li><strong>Email:</strong> ${data.user.email}</li>
                            <li><strong>Role:</strong> <span class="badge bg-primary">${data.user.role}</span></li>
                            <li><strong>Session ID:</strong> ${data.sessionID}</li>
                        </ul>
                    </div>
                `);
            } else {
                $('#authStatus').html(`
                    <div class="alert alert-warning">
                        <h6><i class="fas fa-exclamation-triangle me-2"></i>Not Authenticated</h6>
                        <p class="mb-0">Please <a href="/auth/google?admin=true" class="alert-link">sign in with Google</a> to test admin functions.</p>
                    </div>
                `);
            }
        })
        .catch(error => {
            console.error('Auth check error:', error);
            $('#authStatus').html(`
                <div class="alert alert-danger">
                    <h6><i class="fas fa-times-circle me-2"></i>Error</h6>
                    <p class="mb-0">Failed to check authentication: ${error.message}</p>
                </div>
            `);
        });
}

function testDatabase() {
    $('#dbStatus').html(`
        <div class="text-center">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Testing...</span>
            </div>
            <p class="mt-2">Testing database connection...</p>
        </div>
    `);
    
    fetch('/admin/api/test/db')
        .then(response => response.json())
        .then(data => {
            console.log('Database test response:', data);
            
            if (data.success) {
                $('#dbStatus').html(`
                    <div class="alert alert-success">
                        <h6><i class="fas fa-check-circle me-2"></i>Database Connection: OK</h6>
                        <ul class="mb-0 small">
                            <li>Appointments: ${data.results.appointments}</li>
                            <li>Customers: ${data.results.customers}</li>
                            <li>Products: ${data.results.products}</li>
                            <li>Staff: ${data.results.staff}</li>
                        </ul>
                    </div>
                `);
            } else {
                $('#dbStatus').html(`
                    <div class="alert alert-danger">
                        <h6><i class="fas fa-times-circle me-2"></i>Database Connection: FAILED</h6>
                        <p class="mb-0">${data.error}</p>
                    </div>
                `);
            }
        })
        .catch(error => {
            console.error('Database test error:', error);
            $('#dbStatus').html(`
                <div class="alert alert-danger">
                    <h6><i class="fas fa-times-circle me-2"></i>Error</h6>
                    <p class="mb-0">Database test failed: ${error.message}</p>
                </div>
            `);
        });
}

function testRoute(route) {
    const resultId = `result-${route.replace(/[^a-zA-Z0-9]/g, '')}`;
    
    $('#testResults').append(`
        <div id="${resultId}" class="alert alert-info">
            <i class="fas fa-spinner fa-spin me-2"></i>Testing ${route}...
        </div>
    `);
    
    fetch(route)
        .then(response => response.json())
        .then(data => {
            console.log(`Test result for ${route}:`, data);
            
            if (data.success !== false) {
                $(`#${resultId}`).removeClass('alert-info').addClass('alert-success').html(`
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>${route}:</strong> OK (Count: ${data.count || 'N/A'})
                `);
            } else {
                $(`#${resultId}`).removeClass('alert-info').addClass('alert-warning').html(`
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>${route}:</strong> ${data.error || 'Unknown error'}
                `);
            }
        })
        .catch(error => {
            console.error(`Test error for ${route}:`, error);
            $(`#${resultId}`).removeClass('alert-info').addClass('alert-danger').html(`
                <i class="fas fa-times-circle me-2"></i>
                <strong>${route}:</strong> Failed - ${error.message}
            `);
        });
}

function checkRoleConfig() {
    $('#roleInfo').html(`
        <div class="text-center">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Checking role configuration...</p>
        </div>
    `);
    
    fetch('/admin/debug-role')
        .then(response => response.json())
        .then(data => {
            console.log('Role config response:', data);
            
            $('#roleInfo').html(`
                <div class="alert ${data.userRole === 'admin' ? 'alert-success' : 'alert-warning'}">
                    <h6><i class="fas fa-info-circle me-2"></i>Role Configuration</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Current User:</strong><br>
                            Email: ${data.userEmail}<br>
                            Role: <span class="badge bg-${data.userRole === 'admin' ? 'success' : 'secondary'}">${data.userRole}</span><br>
                            Authenticated: ${data.isAuthenticated ? 'Yes' : 'No'}
                        </div>
                        <div class="col-md-6">
                            <strong>Admin Emails:</strong><br>
                            <small class="text-muted">${data.adminEmails.join(', ')}</small><br>
                            <strong>Staff Emails:</strong><br>
                            <small class="text-muted">${data.staffEmails.join(', ')}</small>
                        </div>
                    </div>
                </div>
            `);
        })
        .catch(error => {
            console.error('Role config error:', error);
            $('#roleInfo').html(`
                <div class="alert alert-danger">
                    <h6><i class="fas fa-times-circle me-2"></i>Error</h6>
                    <p class="mb-0">Failed to check role configuration: ${error.message}</p>
                </div>
            `);
        });
}
</script>