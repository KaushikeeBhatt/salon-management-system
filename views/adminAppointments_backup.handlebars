</style>

<script>
$(document).ready(function() {
    $("#admin-ul").show();
    $("#public-ul").hide();
    
    // Initialize statistics
    updateStatistics();
    
    // Setup search and filter functionality
    setupSearchAndFilter();
});

let currentAppointmentId = null;

// Update statistics counters
function updateStatistics() {
    const appointments = {{#if appointments}}[{{#each appointments}}{ id: {{this.id}}, status: "{{this.status}}", service: "{{this.service}}" },{{/each}}]{{else}}[]{{/if}};
    
    let pending = 0, confirmed = 0, completed = 0;
    
    appointments.forEach(appointment => {
        switch(appointment.status) {
            case 'pending': pending++; break;
            case 'confirmed': confirmed++; break;
            case 'completed': completed++; break;
        }
    });
    
    $('#pendingCount').text(pending);
    $('#confirmedCount').text(confirmed);
    $('#completedCount').text(completed);
}

// Setup search and filter functionality
function setupSearchAndFilter() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const dateFilter = document.getElementById('dateFilter');
    
    function filterAppointments() {
        const searchTerm = searchInput.value.toLowerCase();
        const statusValue = statusFilter.value;
        const dateValue = dateFilter.value;
        
        const rows = document.querySelectorAll('.appointment-row');
        let visibleCount = 0;
        
        rows.forEach(row => {
            const customer = row.dataset.customer.toLowerCase();
            const service = row.dataset.service.toLowerCase();
            const email = row.dataset.email.toLowerCase();
            const status = row.dataset.status;
            const date = row.dataset.date;
            
            const matchesSearch = !searchTerm || 
                customer.includes(searchTerm) || 
                service.includes(searchTerm) || 
                email.includes(searchTerm);
            
            const matchesStatus = !statusValue || status === statusValue;
            const matchesDate = !dateValue || date === dateValue;
            
            if (matchesSearch && matchesStatus && matchesDate) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });
        
        $('#appointmentCount').text(visibleCount);
    }
    
    searchInput.addEventListener('input', filterAppointments);
    statusFilter.addEventListener('change', filterAppointments);
    dateFilter.addEventListener('change', filterAppointments);
}

// Clear all filters
function clearFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('statusFilter').value = '';
    document.getElementById('dateFilter').value = '';
    
    // Trigger filter to show all appointments
    const event = new Event('input');
    document.getElementById('searchInput').dispatchEvent(event);
}

// Show loading overlay
function showLoading() {
    document.getElementById('loadingOverlay').classList.remove('d-none');
}

// Hide loading overlay
function hideLoading() {
    document.getElementById('loadingOverlay').classList.add('d-none');
}

// Refresh appointments
function refreshAppointments() {
    showLoading();
    window.location.reload();
}

// Export appointments (placeholder function)
function exportAppointments() {
    Swal.fire({
        title: 'Export Appointments',
        text: 'Export functionality will be implemented soon.',
        icon: 'info',
        confirmButtonText: 'OK'
    });
}

function viewAppointment(id) {
    showLoading();
    
    fetch(`/admin/appointments/${id}`)
        .then(response => response.json())
        .then(data => {
            hideLoading();
            if (data.success) {
                displayAppointmentDetails(data.appointment);
            } else {
                Swal.fire('Error', 'Failed to load appointment details', 'error');
            }
        })
        .catch(error => {
            hideLoading();
            console.error('Error loading appointment:', error);
            Swal.fire('Error', 'Failed to load appointment details', 'error');
        });
}

function confirmAppointment(id) {
    console.log('confirmAppointment called with id:', id);
    currentAppointmentId = id;
    console.log('currentAppointmentId set to:', currentAppointmentId);
    
    // Set minimum date to today
    const now = new Date();
    const localDateTime = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    document.getElementById('confirmedDateTime').min = localDateTime;
    
    const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
    modal.show();
}

function cancelAppointment(id) {
    Swal.fire({
        title: 'Cancel Appointment?',
        text: 'Are you sure you want to cancel this appointment?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Cancel It'
    }).then((result) => {
        if (result.isConfirmed) {
            updateAppointmentStatus(id, 'cancelled');
        }
    });
}

function deleteAppointment(id) {
    Swal.fire({
        title: 'Delete Appointment?',
        text: 'Are you sure you want to delete this appointment? This action cannot be undone.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Delete It'
    }).then((result) => {
        if (result.isConfirmed) {
            showLoading();
            
            fetch(`/admin/appointments/${id}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                hideLoading();
                if (data.success) {
                    Swal.fire('Success', 'Appointment deleted successfully', 'success')
                        .then(() => location.reload());
                } else {
                    Swal.fire('Error', 'Failed to delete appointment', 'error');
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Error deleting appointment:', error);
                Swal.fire('Error', 'Failed to delete appointment', 'error');
            });
        }
    });
}

function submitConfirmation() {
    const dateTime = document.getElementById('confirmedDateTime').value;
    if (!dateTime) {
        Swal.fire('Error', 'Please select a date and time', 'error');
        return;
    }
    
    showLoading();
    updateAppointmentStatus(currentAppointmentId, 'confirmed', dateTime);
    bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide();
}

function updateAppointmentStatus(id, status, actualDateTime = null) {
    const data = { status };
    if (actualDateTime) {
        data.actualDateTime = actualDateTime;
    }
    
    fetch(`/admin/appointments/${id}/status`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(data => {
        hideLoading();
        if (data.success) {
            Swal.fire('Success', 'Appointment status updated successfully', 'success')
                .then(() => location.reload());
        } else {
            Swal.fire('Error', 'Failed to update appointment', 'error');
        }
    })
    .catch(error => {
        hideLoading();
        console.error('Error updating appointment:', error);
        Swal.fire('Error', 'Failed to update appointment', 'error');
    });
}

function displayAppointmentDetails(appointment) {
    const formatDate = (date) => {
        if (!date) return 'N/A';
        return new Date(date).toLocaleDateString();
    };
    
    const html = `
        <div class="row">
            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="info-card-title">
                        <i class="fas fa-user me-2"></i>Customer Information
                    </h6>
                    <div class="info-card-content">
                        <div class="info-item">
                            <span class="info-label">Name:</span>
                            <span class="info-value">${appointment.firstName || 'N/A'} ${appointment.lastName || ''}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Email:</span>
                            <span class="info-value">${appointment.email || 'N/A'}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Phone:</span>
                            <span class="info-value">${appointment.phone || 'N/A'}</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="info-card-title">
                        <i class="fas fa-calendar-alt me-2"></i>Appointment Details
                    </h6>
                    <div class="info-card-content">
                        <div class="info-item">
                            <span class="info-label">Service:</span>
                            <span class="info-value">${appointment.service || '<em class="text-muted">Not specified</em>'}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Preferred Date:</span>
                            <span class="info-value">${formatDate(appointment.preferredDate)}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Preferred Time:</span>
                            <span class="info-value">${appointment.preferredTime || '<em class="text-muted">Any time</em>'}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Status:</span>
                            <span class="info-value">${getStatusBadge(appointment.status)}</span>
                        </div>
                        ${appointment.actualDateTime ? `
                        <div class="info-item">
                            <span class="info-label">Confirmed Date:</span>
                            <span class="info-value">${formatDate(appointment.actualDateTime)}</span>
                        </div>
                        ` : ''}
                    </div>
                </div>
            </div>
        </div>
        ${appointment.notes ? `
        <div class="mt-3">
            <div class="info-card">
                <h6 class="info-card-title">
                    <i class="fas fa-sticky-note me-2"></i>Notes
                </h6>
                <div class="info-card-content">
                    <p class="mb-0">${appointment.notes}</p>
                </div>
            </div>
        </div>
        ` : ''}
        <div class="mt-3">
            <div class="info-card">
                <h6 class="info-card-title">
                    <i class="fas fa-clock me-2"></i>Booking Information
                </h6>
                <div class="info-card-content">
                    <div class="info-item">
                        <span class="info-label">Booked On:</span>
                        <span class="info-value">${formatDate(appointment.createdAt)}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Appointment ID:</span>
                        <span class="info-value">#${appointment.id}</span>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    document.getElementById('appointmentDetails').innerHTML = html;
    const modal = new bootstrap.Modal(document.getElementById('appointmentModal'));
    modal.show();
}

// Helper function to get status badge HTML
function getStatusBadge(status) {
    const badges = {
        'pending': '<span class="status-badge status-pending"><i class="fas fa-clock me-1"></i>Pending</span>',
        'confirmed': '<span class="status-badge status-confirmed"><i class="fas fa-check-circle me-1"></i>Confirmed</span>',
        'completed': '<span class="status-badge status-completed"><i class="fas fa-calendar-check me-1"></i>Completed</span>',
        'cancelled': '<span class="status-badge status-cancelled"><i class="fas fa-times-circle me-1"></i>Cancelled</span>'
    };
    return badges[status] || status;
}
