<br>
<div class="container">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Contact Messages & Leads</h4>
            <p class="card-subtitle">Manage customer inquiries and messages</p>
        </div>
        <div class="card-block">
            <!-- Stats Row -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="stat-card text-center">
                        <div class="stat-icon text-primary">
                            <i class="fas fa-envelope fa-2x"></i>
                        </div>
                        <h5>{{totalLeads}}</h5>
                        <small class="text-muted">Total Messages</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card text-center">
                        <div class="stat-icon text-warning">
                            <i class="fas fa-bell fa-2x"></i>
                        </div>
                        <h5>{{newLeads}}</h5>
                        <small class="text-muted">New Messages</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card text-center">
                        <div class="stat-icon text-info">
                            <i class="fas fa-eye fa-2x"></i>
                        </div>
                        <h5>{{readLeads}}</h5>
                        <small class="text-muted">Read Messages</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card text-center">
                        <div class="stat-icon text-success">
                            <i class="fas fa-check fa-2x"></i>
                        </div>
                        <h5>{{resolvedLeads}}</h5>
                        <small class="text-muted">Resolved</small>
                    </div>
                </div>
            </div>

            <!-- Filter and Search -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="new">New</option>
                        <option value="read">Read</option>
                        <option value="responded">Responded</option>
                        <option value="resolved">Resolved</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select id="reasonFilter" class="form-select">
                        <option value="">All Reasons</option>
                        <option value="General Inquiry">General Inquiry</option>
                        <option value="Appointment Booking">Appointment Booking</option>
                        <option value="Special Occasion Consultation">Special Occasion Consultation</option>
                        <option value="Product Information">Product Information</option>
                        <option value="Feedback">Feedback</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" id="searchFilter" class="form-control" placeholder="Search by name or email...">
                </div>
            </div>

            <!-- Table -->
            <div style="height: 500px;overflow:auto;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th><strong>Status</strong></th>
                            <th><strong>Name</strong></th>
                            <th><strong>Email</strong></th>
                            <th><strong>Phone</strong></th>
                            <th><strong>Reason</strong></th>
                            <th><strong>Date</strong></th>
                            <th><strong>Details</strong></th>
                            <th><strong>Actions</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each leads}}
                        <tr data-lead-id="{{this.id}}" data-status="{{this.status}}" data-reason="{{this.reason}}">
                            <td>
                                <span class="badge bg-{{#eq this.status 'new'}}warning{{/eq}}{{#eq this.status 'read'}}info{{/eq}}{{#eq this.status 'responded'}}primary{{/eq}}{{#eq this.status 'resolved'}}success{{/eq}}">
                                    {{this.status}}
                                </span>
                            </td>
                            <td>{{this.firstName}} {{this.lastName}}</td>
                            <td>
                                <a href="mailto:{{this.email}}" class="text-decoration-none">{{this.email}}</a>
                            </td>
                            <td>
                                {{#if this.phone}}
                                <a href="tel:{{this.phone}}" class="text-decoration-none">{{this.phone}}</a>
                                {{else}}
                                <span class="text-muted">N/A</span>
                                {{/if}}
                            </td>
                            <td>{{this.reason}}</td>
                            <td>{{formatDate this.createdAt}}</td>
                            <td>
                                <i data-bs-toggle="modal" data-bs-target="#leadModal{{@index}}" class="fa fa-info-circle" style="cursor: pointer;"
                                    aria-hidden="true"></i>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-info btn-sm" onclick="markAsRead({{this.id}})" {{#eq this.status 'read'}}disabled{{/eq}}>
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-success btn-sm" onclick="markAsResolved({{this.id}})" {{#eq this.status 'resolved'}}disabled{{/eq}}>
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteLead({{this.id}})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Lead Details Modals -->
{{#each leads}}
<div class="modal fade" id="leadModal{{@index}}" tabindex="-1" aria-labelledby="leadModalLabel{{@index}}" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="leadModalLabel{{@index}}">
                    <i class="fas fa-envelope me-2"></i>Message from {{this.firstName}} {{this.lastName}}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Name:</strong> {{this.firstName}} {{this.lastName}}</p>
                        <p><strong>Email:</strong> 
                            <a href="mailto:{{this.email}}" class="text-decoration-none">{{this.email}}</a>
                        </p>
                        <p><strong>Phone:</strong> 
                            {{#if this.phone}}
                            <a href="tel:{{this.phone}}" class="text-decoration-none">{{this.phone}}</a>
                            {{else}}
                            <span class="text-muted">Not provided</span>
                            {{/if}}
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Reason:</strong> {{this.reason}}</p>
                        <p><strong>Status:</strong> 
                            <span class="badge bg-{{#eq this.status 'new'}}warning{{/eq}}{{#eq this.status 'read'}}info{{/eq}}{{#eq this.status 'responded'}}primary{{/eq}}{{#eq this.status 'resolved'}}success{{/eq}}">
                                {{this.status}}
                            </span>
                        </p>
                        <p><strong>Received:</strong> {{formatDate this.createdAt}}</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <p><strong>Message:</strong></p>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0">{{this.message}}</p>
                        </div>
                    </div>
                </div>
                {{#if this.ipAddress}}
                <div class="row mt-3">
                    <div class="col-12">
                        <small class="text-muted">IP: {{this.ipAddress}}</small>
                    </div>
                </div>
                {{/if}}
            </div>
            <div class="modal-footer">
                <div class="btn-group" role="group">
                    <a href="mailto:{{this.email}}?subject=Re: Your inquiry&body=Hello {{this.firstName}},%0D%0A%0D%0AThank you for contacting us." 
                       class="btn btn-primary">
                        <i class="fas fa-reply me-1"></i>Reply
                    </a>
                    <button type="button" class="btn btn-info" onclick="markAsRead({{this.id}})" {{#eq this.status 'read'}}disabled{{/eq}}>
                        <i class="fas fa-eye me-1"></i>Mark as Read
                    </button>
                    <button type="button" class="btn btn-success" onclick="markAsResolved({{this.id}})" {{#eq this.status 'resolved'}}disabled{{/eq}}>
                        <i class="fas fa-check me-1"></i>Mark as Resolved
                    </button>
                </div>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
{{/each}}

<script type="text/javascript">
$(document).ready(function() {
    // Add admin classes to body for CSS targeting
    document.body.classList.add('admin-user', 'admin-page');
    
    // Force admin navigation visibility
    const adminNav = document.getElementById('admin-ul');
    const publicNav = document.getElementById('public-ul');
    
    if (adminNav) {
        adminNav.style.display = 'flex';
        adminNav.style.visibility = 'visible';
        adminNav.classList.remove('d-none');
    }
    
    if (publicNav) {
        publicNav.style.display = 'none';
        publicNav.style.visibility = 'hidden';
        publicNav.classList.add('d-none');
    }

    // Filter functionality
    function filterLeads() {
        const statusFilter = $('#statusFilter').val();
        const reasonFilter = $('#reasonFilter').val();
        const searchFilter = $('#searchFilter').val().toLowerCase();

        $('tbody tr').each(function() {
            const row = $(this);
            const status = row.data('status');
            const reason = row.data('reason');
            const name = row.find('td:nth-child(2)').text().toLowerCase();
            const email = row.find('td:nth-child(3)').text().toLowerCase();

            let showRow = true;

            if (statusFilter && status !== statusFilter) {
                showRow = false;
            }

            if (reasonFilter && reason !== reasonFilter) {
                showRow = false;
            }

            if (searchFilter && !name.includes(searchFilter) && !email.includes(searchFilter)) {
                showRow = false;
            }

            if (showRow) {
                row.show();
            } else {
                row.hide();
            }
        });
    }

    $('#statusFilter, #reasonFilter').on('change', filterLeads);
    $('#searchFilter').on('input', filterLeads);
});

function markAsRead(leadId) {
    if (!confirm('Mark this message as read?')) return;
    
    fetch(`/admin/leads/${leadId}/read`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error updating message status');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error updating message status');
    });
}

function markAsResolved(leadId) {
    if (!confirm('Mark this message as resolved?')) return;
    
    fetch(`/admin/leads/${leadId}/resolve`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error updating message status');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error updating message status');
    });
}

function deleteLead(leadId) {
    if (!confirm('Are you sure you want to delete this message? This action cannot be undone.')) return;
    
    fetch(`/admin/leads/${leadId}`, {
        method: 'DELETE'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error deleting message');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error deleting message');
    });
}
</script>