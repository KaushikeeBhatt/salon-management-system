<br>
<div class="container">
    <div class="card">
        <!-- Default card contents -->
        <div class="card-header">
            <h4 class="card-title">Products</h4>
        </div>
        <div class="card-block">

            <!-- Table -->
            <div style="height: 500px;overflow:auto;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th><strong>Brand</strong></strong>
                            </th>
                            <th><strong>Name</strong></th>
                            <th><strong>Size</strong></th>
                            <th><strong>Price</strong></th>
                            <th><strong>Quantity</strong></th>
                            <th><strong>Cost</strong></th>
                            <th><strong>Details</strong></th>
                            <th><strong>Edit</strong></th>
                            <th><strong>Delete</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{!-- show products --}} {{#each products}}
                        <tr>
                            <td>{{this.brand}} </td>
                            <td>{{this.name}}</td>
                            <td>{{this.size}}</td>
                            <td>${{this.price}}</td>
                            <td>{{this.stock_quantity}}</td>
                            <td>${{this.cost}}</td>
                            <td>
                                <i data-bs-toggle="modal" data-bs-target="#productModal{{@index}}" class="fa fa-info-circle" style="cursor: pointer;"
                                    aria-hidden="true"></i>
                            </td>
                            {{!-- update --}}
                            <td>
                                {{#if this.id}}
                                <form action="/admin/products/{{this.id}}/edit" method="GET">
                                    <button type="submit" class="btn btn-info btn-sm"><i class="fas fa-edit" aria-hidden="true"></i> Edit</button>
                                </form>
                                {{else}}
                                <span class="text-muted">No ID</span>
                                {{/if}}
                            </td>
                            {{!-- delete --}}
                            <td>
                                {{#if this.id}}
                                <form action="/admin/products/{{this.id}}?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?')">
                                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                                {{else}}
                                <span class="text-muted">No ID</span>
                                {{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
        <!-- first card body -->
    </div>
    <!--first card -->
    
    <!-- Product Details Modals -->
    {{#each products}}
    <div class="modal fade" id="productModal{{@index}}" tabindex="-1" aria-labelledby="productModalLabel{{@index}}" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productModalLabel{{@index}}">
                        <i class="fas fa-box me-2"></i>Product Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Brand:</strong> {{this.brand}}</p>
                            <p><strong>Name:</strong> {{this.name}}</p>
                            <p><strong>Size:</strong> {{this.size}}</p>
                            <p><strong>Price:</strong> ${{this.price}}</p>
                            <p><strong>Stock Quantity:</strong> {{this.stock_quantity}}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Cost:</strong> ${{this.cost}}</p>
                            <p><strong>Vendor:</strong> {{this.vendor}}</p>
                            <p><strong>Photo URL:</strong> {{#if this.photo}}{{this.photo}}{{else}}<span class="text-muted">No photo URL</span>{{/if}}</p>
                        </div>
                    </div>
                    {{#if this.description}}
                    <div class="row">
                        <div class="col-12">
                            <p><strong>Description:</strong></p>
                            <p class="text-muted">{{this.description}}</p>
                        </div>
                    </div>
                    {{/if}}
                    {{#if this.photo}}
                    <div class="row">
                        <div class="col-12 text-center">
                            <p><strong>Product Image:</strong></p>
                            <img src="{{this.photo}}" alt="{{this.name}}" class="img-fluid" style="max-height: 200px; border-radius: 8px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                            <div class="text-muted" style="display: none;">Image could not be loaded</div>
                        </div>
                    </div>
                    {{/if}}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
    <br> {{!-- Add new product --}}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Add Product</h3>
        </div>
        <!-- penel-heading -->
        <div class="card-block">
            <form class="form-group" action="/admin/products/new" method="POST">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label for="product-brand">Brand</label>
                                <input type="text" class="form-control" id="product-brand" name="brand" placeholder="Brand" autocomplete="organization" required>
                            </div>
                            <div class="form-group">
                                <label for="product-name">Name</label>
                                <input type="text" class="form-control" id="product-name" name="name" placeholder="Name" autocomplete="off" required>
                            </div>
                            <div class="form-group">
                                <label for="product-size">Size</label>
                                <input type="text" class="form-control" id="product-size" name="size" placeholder="size" autocomplete="off">
                            </div>
                            <div class="form-group">
                                <label for="product-price">Price</label>
                                <input type="number" class="form-control" id="product-price" name="price" placeholder="0.00" step="0.01" min="0" autocomplete="off" required>
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="product-stock">Stock Quantity</label>
                                <input type="number" class="form-control" id="product-stock" name="stock_quantity" placeholder="0" min="0" autocomplete="off" required>
                            </div>
                            <div class="form-group">
                                <label for="product-cost">Cost</label>
                                <input type="number" class="form-control" id="product-cost" name="cost" placeholder="0.00" step="0.01" min="0" autocomplete="off" required>
                            </div>
                            <div class="form-group">
                                <label for="product-vendor">Vendor</label>
                                <input type="text" class="form-control" id="product-vendor" name="vendor" placeholder="Vendor" autocomplete="organization">
                            </div>
                            <div class="form-group">
                                <label for="product-photo">Photo</label>
                                <input type="url" class="form-control" id="product-photo" name="photo" placeholder="Photo URL" autocomplete="photo">
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="product-description">Description</label>
                                <textarea class="form-control" id="product-description" name="description" placeholder="Description" rows="8" style="height:20em" autocomplete="off"></textarea>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Product</button>
                </div>{{!-- container --}}
            </form>
        </div>
        <!-- card-block -->
    </div>
    <!-- second card -->
</div>
<script type="text/javascript">
$(document).ready(function() {
    // Add admin classes to body for CSS targeting
    document.body.classList.add('admin-user', 'admin-page');
    
    // Force admin navigation visibility
    const adminNav = document.getElementById('admin-ul');
    const publicNav = document.getElementById('public-ul');
    
    if (adminNav) {
        adminNav.style.display = 'flex';
        adminNav.style.visibility = 'visible';
        adminNav.classList.remove('d-none');
        console.log('✅ Admin nav forced visible');
    }
    
    if (publicNav) {
        publicNav.style.display = 'none';
        publicNav.style.visibility = 'hidden';
        publicNav.classList.add('d-none');
        console.log('✅ Public nav hidden');
    }
    
    // Debug: Log all product data to check for missing IDs
    console.log('🔍 Product data check:');
    $('tbody tr').each(function(index) {
        const editForm = $(this).find('form[action*="/edit"]');
        const productId = editForm.attr('action');
        console.log('Product', index + 1, '- Edit URL:', productId);
    });
});
</script>
