<br>
<div class="container">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Update Salon</h3>
        </div>
        <!-- penel-heading -->
        <div class="card-block">
            <form class="form-group" action="/admin/salon/update?_method=PUT" method="POST">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label for="salon-name">Salon Name</label>
                                <input type="text" class="form-control" id="salon-name" name="name" placeholder="Salon name" value="{{editSalon.name}}" required>
                            </div>
                            <div class="form-group">
                                <label for="salon-password">Password</label>
                                <input type="password" class="form-control" id="salon-password" name="password" placeholder="Password" value="{{editSalon.password}}">
                            </div>
                            <div class="form-group">
                                <label for="salon-email">Email</label>
                                <input type="email" class="form-control" id="salon-email" name="email" placeholder="REQUIRED" value="{{editSalon.Email.email}}" required>
                            </div>
                            <div class="form-group">
                                <label for="salon-mobile">Mobile</label>
                                <input type="tel" class="form-control" id="salon-mobile" name="mobile" placeholder="mobile" value="{{editSalon.Phone.mobile}}">
                            </div>
                            <div class="form-group">
                                <label for="salon-home">Home</label>
                                <input type="tel" class="form-control" id="salon-home" name="home" placeholder="home" value="{{editSalon.Phone.home}}">
                            </div>
                        <div class="form-group">
                            <label for="salon-photo">Photo URL</label>
                            <input type="url" class="form-control" id="salon-photo" name="photo" placeholder="Photo URL" value="{{editSalon.photo}}">
                        </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="salon-address1">Address1</label>
                                <input type="text" class="form-control" id="salon-address1" name="address1" placeholder="address1" value="{{editSalon.Address.address1}}">
                            </div>
                            <div class="form-group">
                                <label for="salon-address2">Address2</label>
                                <input type="text" class="form-control" id="salon-address2" name="address2" placeholder="address2" value="{{editSalon.Address.address2}}">
                            </div>
                            <div class="form-group">
                                <label for="salon-city">City</label>
                                <input type="text" class="form-control" id="salon-city" name="city" placeholder="city" value="{{editSalon.Address.city}}">
                            </div>
                            <div class="form-group">
                                <label for="salon-state">State</label>
                                <input type="text" class="form-control" id="salon-state" name="state" placeholder="state" value="{{editSalon.Address.state}}">
                            </div>
                            <div class="form-group">
                                <label for="salon-zip">Zip</label>
                                <input type="text" class="form-control" id="salon-zip" name="zip" placeholder="zip" value="{{editSalon.Address.zip}}">
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="salon-description">Description</label>
                                <textarea class="form-control" id="salon-description" name="description" placeholder="Description" rows="8" style="height:20em">{{editSalon.description}}</textarea>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Update Salon</button>
                </div>{{!-- container --}}
                <input type="hidden" value="{{editSalon.Phone.id}}" name ="phoneId"/>
                <input type="hidden" value="{{editSalon.Email.id}}" name ="emailId"/>
                <input type="hidden" value="{{editSalon.Address.id}}" name ="addressId"/>
            </form>
        </div>
        <!-- card-block -->
    </div>
    <!-- second card -->
</div>{{!-- container --}}
<script type="text/javascript">
    $(document).ready(function() {
        $("#admin-ul").show();
        $("#public-ul").hide();
    });
</script>