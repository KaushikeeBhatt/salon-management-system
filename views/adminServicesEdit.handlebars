<br> {{!-- Add new product --}}
<div class="container">
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Add Service
        </h3>
    </div>
    <!-- penel-heading -->
    <div class="card-block">
        <form class="form-group" action="/admin/services/{{editservice.id}}?_method=PUT" method="POST">
            <div class="container">
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label for="">Name</label>
                            <input type="text" class="form-control" name="name" placeholder="Name" value="{{editservice.name}}" required>
                        </div>
                        <div class="form-group">
                            <label for="">Duration (minutes)</label>
                            <input type="number" class="form-control" name="duration" placeholder="Duration" value="{{editservice.duration}}" min="1" max="480">
                        </div>
                        <div class="form-group">
                            <label for="">Member Price ($)</label>
                            <input type="number" class="form-control" name="member_price" placeholder="0.00" value="{{editservice.member_price}}" step="0.01" min="0">
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="">Non Member Price ($)</label>
                            <input type="number" class="form-control" name="nonmember_price" placeholder="0.00" value="{{editservice.nonmember_price}}" step="0.01" min="0">
                        </div>
                        <div class="form-group">
                            <label for="">Cost ($)</label>
                            <input type="number" class="form-control" name="cost" placeholder="0.00" value="{{editservice.cost}}" step="0.01" min="0" required>
                        </div>
                        <div class="form-group">
                            <label for="">Photo</label>
                            <input type="text" class="form-control" name="photo" placeholder="Photo" value="{{editservice.photo}}">
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label for="">Comment</label>
                            <textarea class="form-control" name="comment" placeholder="Comment" rows="5" style="height:10em">{{editservice.comment}}</textarea>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Update Service</button>
            </div>{{!-- container --}}
        </form>
    </div>
    <!-- card-block -->
</div>
<!-- second card -->
</div>
<script type="text/javascript">
    $(document).ready(function() {
        $("#admin-ul").show();
        $("#public-ul").hide();
    });
</script>